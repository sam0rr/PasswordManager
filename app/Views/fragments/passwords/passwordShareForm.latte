{var $passwordId = isset($password) ? $password->id : ''}
{var $form = Controllers\src\Utils\SessionHelper::getForm("share_{$passwordId}")}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title" id="sharePasswordModalLabel-{$passwordId}">
        <i class="bi bi-send-plus me-2"></i>Share Password
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
</div>

<div class="modal-body">
    <div id="share-form-wrapper-{$passwordId}">
        <form method="post"
              action="/share/{$passwordId}"
              hx-post="/share/{$passwordId}"
              hx-trigger="change"
              hx-target="#share-form-wrapper-{$passwordId}"
              hx-swap="morphdom"
              hx-preserve="true"
              novalidate>

            {$csrf_keep_alive|noescape}

            {include '../../components/formField.latte',
            name => 'email',
            label => 'Email To',
            icon => 'envelope-at',
            type => 'email',
            form => $form
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send-check me-1"></i> Share
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Dismiss
                </button>
            </div>
        </form>
    </div>
</div>
