{var $passwordId = isset($password) ? $password->id : ''}
{var $context = "password_update_{$passwordId}"}
{var $form = Controllers\src\Utils\SessionHelper::getForm($context)}

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title" id="editPasswordModalLabel-{$passwordId}">
        <i class="bi bi-pencil-square me-2"></i>Modify Password
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div id="password-form-wrapper-{$passwordId}">
        <form method="post"
              action="/password/{$passwordId}"
              hx-post="/password/{$passwordId}"
              hx-trigger="change"
              hx-target="#password-form-wrapper-{$passwordId}"
              hx-swap="morphdom"
              hx-preserve="true"
              novalidate>

            {$csrf_keep_alive|noescape}

            {include '../../components/formField.latte',
            name => 'description',
            label => 'Description',
            icon => 'text-paragraph',
            type => 'text',
            value => $form->getValue('description') ?? (isset($password) ? $password->description : ''),
            form => $form,
            context => $context
            }

            {include '../../components/formField.latte',
            name => 'note',
            label => 'Note',
            icon => 'sticky',
            type => 'textarea',
            value => $form->getValue('note') ?? (isset($password) ? $password->note : ''),
            form => $form,
            context => $context
            }

            {include '../../components/formField.latte',
            name => 'password',
            label => 'Password',
            icon => 'key',
            type => 'password',
            value => $form->getValue('password') ?? (isset($password) ? $password->password : ''),
            form => $form,
            context => $context
            }

            <div class="form-check mt-3">
                <input type="hidden" name="verified" value="0">

                <input class="form-check-input"
                       type="checkbox"
                       id="verified-{$passwordId}"
                       name="verified"
                       value="1"
                       {if $form->getValue('verified') ?? (isset($password) ? $password->verified : '') == '1'}checked{/if}>

                <label class="form-check-label" for="verified-{$passwordId}">
                    Password Verified
                </label>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i> Save
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Dismiss
                </button>
            </div>
        </form>
    </div>
</div>
