{define #passwordCard}
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex flex-column">

                <!-- Titre & actions -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="mb-0">{$password->description}</h5>
                    <div class="d-flex gap-2">
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary"
                                data-bs-toggle="modal"
                                data-bs-target="#sharePasswordModal-{$password->id}">
                            <i class="bi bi-send-plus me-1"></i>Partager
                        </button>
                        <button type="button"
                                class="btn btn-sm btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#editPasswordModal-{$password->id}">
                            <i class="bi bi-pencil me-1"></i>Modifier
                        </button>
                    </div>
                </div>

                <!-- Badge Vérifié / Non vérifié -->
                <div class="mb-3">
                    {if $password->verified}
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>Vérifié
                        </span>
                    {else}
                        <span class="badge bg-danger">
                            <i class="bi bi-exclamation-circle me-1"></i>Non vérifié
                        </span>
                    {/if}
                </div>

                <!-- Note -->
                <p class="text-muted mb-3">{$password->note ?? "Aucune note"}</p>

                <ul class="list-unstyled small mb-4 px-4">
                    <li class="d-flex justify-content-between mb-1">
                        <span class="fw-bold">Email lié :</span>
                        <span class="text-muted">{$password->email_from}</span>
                    </li>
                    <li class="d-flex justify-content-between mb-1">
                        <span class="fw-bold">Créé le :</span>
                        <span class="text-muted">{$password->created_at|date:'d/m/Y à H:i'}</span>
                    </li>
                    <li class="d-flex justify-content-between mb-1">
                        <span class="fw-bold">Modifié le :</span>
                        <span class="text-muted">{$password->updated_at|date:'d/m/Y à H:i'}</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span class="fw-bold">Dernière utilisation :</span>
                        {if $password->last_use}
                            <span class="text-muted">{$password->last_use|date:'d/m/Y à H:i'}</span>
                        {else}
                            <span class="text-muted">Jamais</span>
                        {/if}
                    </li>
                </ul>

                <div class="mt-auto d-flex align-items-center">
                    <div class="input-group input-group-sm me-3 flex-grow-1">
                        <input type="password"
                               id="pw-{$password->id}"
                               class="form-control"
                               value="{$password->password}"
                               readonly data-password>
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-password-toggle="pw-{$password->id}">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                    <form method="post"
                          action="/password/{$password->id}/delete"
                          class="flex-shrink-0 ms-2">
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>

                {include 'passwordUpdateModal.latte', password => $password, form => $form}
                {include 'passwordShareModal.latte',  password => $password, form => $form}
            </div>
        </div>
    </div>
{/define}
