{varType ?object $method}
{varType string $methodType}
{varType int $mfa_expiration}
{varType int $mfa_grace_period_days}

<div class="mb-4">
    <div class="card-header bg-white">
        <div class="fw-bold text-dark">
            <i class="bi bi-lock-fill me-2"></i>
            {switch $methodType}
                {case 'mail'}Mail Authentication
                {case 'sms'}SMS Authentication
                {case 'authenticator'}Application Authenticator (TOTP)
                {default}Method Not Found
            {/switch}
        </div>
    </div>

    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            <div class="list-group-item d-flex flex-column flex-md-row justify-content-between align-items-start">
                <div class="mb-2 mb-md-0 w-100 w-md-50">
                    <div class="text-muted small">
                        {if $method && $method->is_active}
                            {if $method->last_verified}
                                {var $isExpired = $method->grace_period_enabled
                                ? strtotime($method->last_verified) + ($mfa_grace_period_days * 86400) < time()
                                : strtotime($method->last_verified) + $mfa_expiration < time()
                                }

                                {if !$isExpired}
                                    Verified: {$method->last_verified|date:'d/m/Y at H:i'}
                                    {if $method->grace_period_enabled}
                                        <span class="badge bg-success ms-2 align-middle">
                                            Valid For {ceil((strtotime($method->last_verified) + ($mfa_grace_period_days * 86400) - time()) / 86400)} Days
                                        </span>
                                    {else}
                                        <span class="badge bg-success ms-2 align-middle">
                                            Verified
                                        </span>
                                    {/if}
                                {else}
                                    <span class="badge bg-danger ms-2 align-middle">Expired</span>
                                {/if}
                            {else}
                                <span class="text-muted">Never Verified</span>
                            {/if}
                        {else}
                            <span class="text-muted">Method Disabled</span>
                        {/if}
                    </div>

                    {if $method && $method->is_active && $method->grace_period_enabled}
                        <div class="text-muted small mt-1">
                            <i class="bi bi-info-circle me-1"></i>
                            Grace Period Enabled
                        </div>
                    {/if}
                </div>

                <div class="w-100 w-md-50 text-end">
                    <div class="d-flex flex-column flex-md-row justify-content-end gap-2 mt-2 mt-md-0">
                        {if $method && $method->is_active}
                            {if $methodType == 'authenticator'}
                                <button type="button" class="btn btn-sm btn-primary w-auto align-self-start"
                                        hx-get="/verify/qrcode"
                                        hx-target="#qr-code-container"
                                        data-bs-toggle="modal"
                                        data-bs-target="#qr-code-modal">
                                    <i class="bi bi-qr-code"></i>
                                </button>
                            {/if}

                            {if $method->grace_period_enabled}
                                {include '../verify/mfaFormButton.latte',
                                action => 'grace-period/deactivate',
                                methodType => $methodType,
                                style => 'primary',
                                icon => 'calendar-x',
                                label => 'Disable Grace Period',
                                size => 'sm'
                                }
                            {else}
                                {include '../verify/mfaFormButton.latte',
                                action => 'grace-period/activate',
                                methodType => $methodType,
                                style => 'primary',
                                icon => 'calendar-check',
                                label => 'Enable Grace Period',
                                size => 'sm'
                                }
                            {/if}

                            {include '../verify/mfaFormButton.latte',
                            action => 'deactivate',
                            methodType => $methodType,
                            style => 'outline-danger',
                            icon => 'x-circle',
                            label => 'Disable',
                            size => 'sm'
                            }
                        {else}
                            {include '../verify/mfaFormButton.latte',
                            action => 'activate',
                            methodType => $methodType,
                            style => 'primary',
                            icon => 'shield-plus',
                            label => 'Enable',
                            size => 'sm'
                            }
                        {/if}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
