{var $form = Controllers\src\Utils\SessionHelper::getForm('mfa_confirm')}
{var $method = 'mail'}
{var $label = $method == 'mail' ? 'Code Received By Email' : ($method == 'sms' ? 'Code Received By SMS' : ($method == 'authenticator' ? 'Code Generated By The App' : ''))}

<div id="verify-form-wrapper">
    {include './mfaFlashMessage.latte'}
    <form method="post"
          action="/verify/confirm"
          hx-post="/verify/confirm"
          hx-trigger="change"
          hx-target="#verify-form-wrapper"
          hx-swap="morphdom"
          hx-preserve="true"
          novalidate>
        {$csrf_keep_alive|noescape}

        <input type="hidden" name="method" value="{$method}">

        {include '../../components/formField.latte',
        name => 'code',
        label => $label,
        icon => 'chat-dots',
        form => $form,
        context => $method
        }

        <div class="d-grid gap-2 mt-4">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-shield-check me-2"></i>Verify
            </button>

            <button type="button" class="btn btn-outline-secondary"
                    hx-post="/verify/send"
                    hx-vals='{"method": "{$method}"}'
                    hx-target="#verify-form-wrapper"
                    hx-swap="morphdom">
                <i class="bi bi-arrow-repeat me-2"></i>Resend Code
            </button>
        </div>
    </form>
</div>
