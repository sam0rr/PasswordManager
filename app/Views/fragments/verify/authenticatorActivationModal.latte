<div class="modal fade" id="activateAuthenticatorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-shield-check me-2"></i>Activer l'authentification TOTP
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>L'authentification par application (TOTP) vous permettra de sécuriser votre compte avec une application comme Google Authenticator ou Microsoft Authenticator.</p>

                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Une fois activée, vous aurez accès au code QR à scanner avec votre application.
                </div>

                <form method="post" id="authenticator-form"
                      hx-post="/verify/activate"
                      hx-target="#activateAuthenticatorModal"
                      hx-swap="morphdom"
                      hx-preserve="true"
                    <input type="hidden" name="method" value="authenticator">
                    {$csrf_keep_alive|noescape}

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Activer
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>