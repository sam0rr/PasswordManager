<form method="post"
      action="/verify/confirm"
      hx-post="/verify/confirm"
      hx-target="#verify-form-wrapper"
      hx-swap="morphdom"
      novalidate>

    <input type="hidden" name="method" value="sms">

    {include '../../components/formField.latte', name => 'code', label => 'Code reçu par SMS', icon => 'chat-dots'}

    <div class="d-grid gap-2 mt-4">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="bi bi-shield-check me-2"></i>Valider
        </button>
    </div>
</form>
