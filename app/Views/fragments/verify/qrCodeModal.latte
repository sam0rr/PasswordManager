{if isset($message)}
    {include '../../components/alert/messageAlert.latte', message => $message, type => 'success'}
{/if}

<div class="modal fade" id="qr-code-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-qr-code me-2"></i>QR Code For Authentication
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="text-center mb-4">
                    <div id="qr-code-container" class="my-4">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="modal-verify-form-wrapper">
                    {include 'qrCodeModalForm.latte'}
                </div>
            </div>
        </div>
    </div>
</div>
