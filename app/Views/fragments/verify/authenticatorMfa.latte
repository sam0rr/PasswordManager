{var $form = Controllers\src\Utils\SessionHelper::getForm('mfa_confirm')}

<div id="verify-form-wrapper">
    <form method="post"
          action="/verify/confirm"
          hx-post="/verify/confirm"
          hx-trigger="change"
          hx-target="#verify-form-wrapper"
          hx-swap="morphdom"
          hx-preserve="true"
          novalidate>

        <input type="hidden" name="method" value="authenticator">

        {include '../../components/formField.latte', name => 'code', label => 'Code reçu par courriel', icon => 'chat-dots', form => $form}

        <div class="d-grid gap-2 mt-4">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-shield-check me-2"></i>Valider
            </button>
        </div>
    </form>
</div>
