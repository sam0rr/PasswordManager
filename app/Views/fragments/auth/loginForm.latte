<div id="login-form-wrapper">
    <form method="post"
          action="/login"
          hx-post="/login"
          hx-trigger="change"
          hx-target="#login-form-wrapper"
          hx-swap="morphdom"
          hx-preserve="true"
          novalidate>
        {$csrf_keep_alive|noescape}

        {if $form->hasError('login') && $form->getValue('submit') == 'true' && !$isHtmx}
            {include '../../components/alert/messageAlert.latte',
            message => getErrorMessage('login', $form),
            type => 'error'
            }
        {/if}

        {include '../../components/formField.latte', name => 'email', label => 'Email', icon => 'envelope'}
        {include '../../components/formField.latte', name => 'password', label => 'Password', icon => 'lock', type => 'password'}

        <div class="d-grid gap-2 mt-4">
            <input type="hidden" name="submit" value="true" />
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </button>
        </div>
    </form>
</div>
