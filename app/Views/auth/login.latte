{layout '../layouts/main.latte'}

{block content}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card shadow border-0 rounded-3 mt-5">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <h1 class="h3 mb-0">Login</h1>
                    </div>
                    <div class="card-body p-4">

                        {if ($flash = \Controllers\src\Utils\SessionHelper::getFlash('login_error'))}
                            {include '../components/alert/messageAlert.latte', message => $flash['message'], type => $flash['type']}
                        {/if}

                        <div id="login-form-wrapper">
                            {include '../fragments/auth/loginForm.latte'}
                        </div>
                    </div>
                    <div class="card-footer bg-light p-3 text-center">
                        <p class="mb-0">
                            Don't have an account ?
                            <a href="/register" class="link-primary-style">Register</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{/block}
