{varType array $mfa}
{varType int $mfa_expiration}
{varType int $otp_expiration}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-shield-lock me-2"></i>Double authentification
        </h5>
    </div>

    <div class="card-body">
        {if count($mfa) == 0}
            <div class="alert alert-danger alert-dismissible fade show mt-3 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Aucune méthode d’authentification activée.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {/if}

        <div class="list-group list-group-flush">
            {foreach ['mail', 'sms', 'authenticator'] as $methodType}
                {var $method = null}
                {foreach $mfa as $m}
                    {if $m->method === $methodType}
                        {var $method = $m}
                        {breakIf true}
                    {/if}
                {/foreach}

                {include '../../fragments/profile/mfaMethodRow.latte',
                method => $method,
                methodType => $methodType,
                mfa_expiration => $mfa_expiration,
                otp_expiration => $otp_expiration
                }
            {/foreach}
        </div>
    </div>
</div>

{include '../../fragments/verify/qrCodeModal.latte'}
