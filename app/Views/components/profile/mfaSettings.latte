<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-shield-lock me-2"></i>Double authentification
        </h5>
    </div>

    <div class="card-body">
        {if count($mfa) == 0}
            <div class="alert alert-danger alert-dismissible fade show mt-3 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Aucune méthode d’authentification activée.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {/if}

        <div class="list-group list-group-flush">
            {foreach ['mail', 'sms', 'authenticator'] as $methodType}
                {var $method = null}
                {foreach $mfa as $m}
                    {if $m->method == $methodType}
                        {var $method = $m}
                    {/if}
                {/foreach}

                <div class="list-group-item d-flex justify-content-between align-items-start flex-column flex-md-row">
                    <div class="mb-2 mb-md-0 w-100 w-md-50">
                        <div class="fw-bold text-dark">
                            <i class="bi bi-lock-fill me-2"></i>
                            {if $methodType == 'mail'}Authentification par courriel{/if}
                            {if $methodType == 'sms'}Authentification par SMS{/if}
                            {if $methodType == 'authenticator'}Application Authenticator (TOTP){/if}
                        </div>

                        <div class="text-muted small mt-1">
                            {if $method && $method->is_active}
                                Vérifiée :
                                {if $method->last_verified}
                                    {$method->last_verified|date:'d/m/Y à H:i'}
                                    {if strtotime($method->last_verified) + 300 < time()}
                                        <span class="badge bg-danger ms-2">Expiré</span>
                                    {/if}
                                {else}
                                    <span class="text-muted">Jamais vérifiée</span>
                                {/if}
                            {else}
                                <span class="text-muted">Méthode désactivée</span>
                            {/if}
                        </div>
                    </div>

                    <div class="text-end w-100 w-md-50">
                        <form method="post" action="/verify/{= $method && $method->is_active ? 'deactivate' : 'activate'}">
                            <input type="hidden" name="method" value="{$methodType}">
                            <button type="submit"
                                    class="btn btn-sm {= $method && $method->is_active ? 'btn-outline-danger' : 'btn-primary'}">
                                {if $method && $method->is_active}
                                    <i class="bi bi-x-circle me-1"></i> Désactiver
                                {else}
                                    <i class="bi bi-shield-plus me-1"></i> Activer
                                {/if}
                            </button>
                        </form>
                    </div>
                </div>
            {/foreach}
        </div>
    </div>
</div>
