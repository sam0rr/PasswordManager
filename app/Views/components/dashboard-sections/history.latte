{import '../../fragments/history/historyCard.latte'}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-clock-history me-2"></i>Login History
            </h5>
            {if count($auth_history) > 0}
                <form method="post" action="/history/deleteAll">
                    <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap">
                        <i class="bi bi-trash me-1"></i>Delete all
                    </button>
                </form>
            {/if}
        </div>
    </div>
    <div class="card-body">
        {if count($auth_history) > 0}
            <div id="accordionHistory" class="accordion">
                {foreach $auth_history as $history}
                    {include #historyCard, history => $history}
                {/foreach}
            </div>
        {else}
            <p class="text-muted">No Login History Available.</p>
        {/if}
    </div>
</div>