{var $profileTab = $_GET['tab'] ?? 'info'}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Paramètres du compte</h5>
    </div>

    <div class="card-body">
        <div class="d-md-none mb-3">
            <select class="form-select" id="profile-tab-selector" onchange="location.href=this.value;">
                <option value="?section=profile&tab=info" {$profileTab == 'info' ? 'selected' : ''}>
                    Modifier mes informations
                </option>
                <option value="?section=profile&tab=password" {$profileTab == 'password' ? 'selected' : ''}>
                    Changer mon mot de passe
                </option>
                <option value="?section=profile&tab=mfa" {$profileTab == 'mfa' ? 'selected' : ''}>
                    Double authentification
                </option>
            </select>
        </div>

        <ul class="nav nav-tabs d-none d-md-flex mb-4 flex-wrap">
            <li class="nav-item">
                <a class="nav-link {$profileTab == 'info' ? 'active' : ''}" href="?section=profile&tab=info">
                    Modifier mes informations
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {$profileTab == 'password' ? 'active' : ''}" href="?section=profile&tab=password">
                    Changer mon mot de passe
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {$profileTab == 'mfa' ? 'active' : ''}" href="?section=profile&tab=mfa">
                    Double authentification
                </a>
            </li>
        </ul>

        {if $profileTab == 'info'}
            {include '../profile/updateProfile.latte', user => $user}
        {elseif $profileTab == 'password'}
            {include '../profile/updatePassword.latte'}
        {elseif $profileTab == 'mfa'}
            {include '../profile/mfaSettings.latte', mfa => $mfa, mfa_expiration => $mfa_expiration, otp_expiration => $otp_expiration}
        {/if}
    </div>
</div>
