{import '../../fragments/security/securityCard.latte'}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">
            <i class="bi bi-shield-lock me-2"></i>Analyse de sécurité des mots de passe
        </h5>
    </div>
    <div class="card-body">
        {if count($security_analysis) > 0}
            <div class="list-group list-group-flush">
                {foreach $security_analysis as $entry}
                    {include #securityCard, entry => $entry}
                {/foreach}
            </div>
        {else}
            <p class="text-muted mb-0">Aucune donnée de sécurité disponible.</p>
        {/if}
    </div>
</div>
